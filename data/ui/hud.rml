<rml>
	<head>
		<title>Playing HUD</title>
		<link type="text/rcss" href="theme.rcss"/>
		<link type="text/rcss" href="hud.rcss"/>
		<style>
/* Transparent stage: the HUD floats over the live world. Panels carry
   their own backgrounds; the stub proof doc does the same. */
body {
	background: transparent;
}
</style>
	</head>
	<body id="hud-body">
		<div class="hud-panel" id="hud-stockpile">
			<div class="hud-title">Stockpile</div>
			<div class="hud-line" id="res-line"></div>
		</div>
		<div id="hud-groups">
			<div class="cg-box" id="cg-0"></div>
			<div class="cg-box" id="cg-1"></div>
			<div class="cg-box" id="cg-2"></div>
			<div class="cg-box" id="cg-3"></div>
			<div class="cg-box" id="cg-4"></div>
			<div class="cg-box" id="cg-5"></div>
			<div class="cg-box" id="cg-6"></div>
			<div class="cg-box" id="cg-7"></div>
			<div class="cg-box" id="cg-8"></div>
			<div class="cg-box" id="cg-9"></div>
		</div>
		<div class="hud-panel" id="hud-selection">
			<div class="hud-title">Selection</div>
			<div class="hud-line" id="sel-line"></div>
		</div>
		<div class="hud-panel" id="hud-abilities">
			<div class="hud-title">Abilities</div>
			<div id="abilities-grid">
				<button class="ab-btn" id="ab-hold"></button>
				<button class="ab-btn" id="ab-guard"></button>
				<button class="ab-btn" id="ab-patrol"></button>
				<button class="ab-btn" id="ab-attackmove"></button>
				<button class="ab-btn" id="ab-halt"></button>
				<button class="ab-btn" id="ab-repair"></button>
				<button class="ab-btn" id="ab-heal"></button>
				<button class="ab-btn" id="ab-rally"></button>
				<button class="ab-btn" id="ab-demolish"></button>
			</div>
		</div>
		<div class="hud-panel" id="hud-production">
			<div class="hud-title">Production</div>
			<div id="production-tabs">
				<button class="tab-btn" id="tab-infantry">Inf</button>
				<button class="tab-btn" id="tab-vehicles">Veh</button>
				<button class="tab-btn" id="tab-buildings">Bld</button>
			</div>
			<div id="rows-infantry">
				<div class="prod-row">
					<button class="prod-btn" id="prod-i-0"></button>
					<button class="prod-rep" id="repr-i-0"></button>
				</div>
				<div class="prod-row">
					<button class="prod-btn" id="prod-i-1"></button>
					<button class="prod-rep" id="repr-i-1"></button>
				</div>
				<div class="prod-row">
					<button class="prod-btn" id="prod-i-2"></button>
					<button class="prod-rep" id="repr-i-2"></button>
				</div>
				<div class="prod-row">
					<button class="prod-btn" id="prod-i-3"></button>
					<button class="prod-rep" id="repr-i-3"></button>
				</div>
			</div>
			<div id="rows-vehicles">
				<div class="prod-row">
					<button class="prod-btn" id="prod-v-0"></button>
					<button class="prod-rep" id="repr-v-0"></button>
				</div>
				<div class="prod-row">
					<button class="prod-btn" id="prod-v-1"></button>
					<button class="prod-rep" id="repr-v-1"></button>
				</div>
				<div class="prod-row">
					<button class="prod-btn" id="prod-v-2"></button>
					<button class="prod-rep" id="repr-v-2"></button>
				</div>
				<div class="prod-row">
					<button class="prod-btn" id="prod-v-3"></button>
					<button class="prod-rep" id="repr-v-3"></button>
				</div>
			</div>
			<div id="rows-buildings">
				<div class="prod-row">
					<button class="prod-btn" id="place-0"></button>
				</div>
				<div class="prod-row">
					<button class="prod-btn" id="place-1"></button>
				</div>
				<div class="prod-row">
					<button class="prod-btn" id="place-2"></button>
				</div>
				<div class="prod-row">
					<button class="prod-btn" id="place-3"></button>
				</div>
			</div>
			<div class="hud-line" id="need-production">Need Bootcamp / Workshop</div>
			<div id="prod-queue-row">
				<span id="queue-line"></span>
				<button id="btn-cancel">Cancel</button>
			</div>
		</div>
		<div id="hud-producing">
			<div id="producing-bootcamp">
				<div class="producing-label">Bootcamp</div>
				<div class="producing-bar">
					<div id="producing-fill-bootcamp"/>
				</div>
			</div>
			<div id="producing-workshop">
				<div class="producing-label">Workshop</div>
				<div class="producing-bar">
					<div id="producing-fill-workshop"/>
				</div>
			</div>
		</div>
		<div class="hud-readout" id="fps-line"></div>
		<div id="hud-hints"></div>
	</body>
</rml>
