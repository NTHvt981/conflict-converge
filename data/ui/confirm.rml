<rml>
<head>
<title>Confirm</title>
<link type="text/rcss" href="theme.rcss"/>
<style>
/* Transparent stage: the #dim veil dims whatever is behind (menu doc or
   world); the opaque theme body would hide it entirely. */
body {
	background: transparent;
}
</style>
</head>
<body>
<div id="dim"></div>
<div id="confirm-box">
<div id="confirm-titlebar"><span id="confirm-title">Quit Conflict Converge?</span></div>
<p id="confirm-sub">Close the game?</p>
<button id="btn-yes">Yes</button>
<button id="btn-no">No</button>
</div>
</body>
</rml>
