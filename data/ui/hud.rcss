/* Step-2 HUD look. Same raygui-derived palette as theme.rcss; geometry
   mirrors src/game/private/app/Hud.cpp panel positions (base window
   1280x720). Right/bottom-anchored panels scale with the window. Sizes are grown
   slightly wherever the probe's 22px-at-scale-1 bitmap font cannot fit
   the real 10-16px raygui rows; anchors stay faithful. Lengths use dp
   (see theme.rcss); pause/outcome overlays center like confirm-box. */

.hud-panel {
	position: absolute;
	background: #f5f5f5;
	border: 1dp #838383;
}

.hud-title {
	width: 100%;
	height: 20dp;
	background: #c9c9c9;
	color: #505050;
	font-weight: bold;
	text-align: center;
}

.hud-line {
	margin-left: 8dp;
	margin-right: 8dp;
	margin-top: 6dp;
	color: #686868;
	white-space: nowrap;
}

/* Stockpile sits under the square top-right minimap (size 33.3% of the
   height + 10dp margin): 36% clears it on windows 375px and taller. */
#hud-stockpile {
	right: 10dp;
	top: 36%;
	width: 19%;
}

/* DrawSelectionPanel: (8,screenH-64,300,56) "Selection". Widened so the
   single-unit summary fits the fixed probe font. */
#hud-selection {
	left: 8dp;
	bottom: 8dp;
	width: 340dp;
	height: 56dp;
}

/* DrawControlGroupStrip: y=70, 10 boxes 26x20 gap 2 from x=8.
   Boxes widened to 40dp so "<digit>:<count>" fits the probe font. */
#hud-groups {
	position: absolute;
	left: 8dp;
	top: 70dp;
}

.cg-box {
	display: inline-block;
	width: 40dp;
	height: 22dp;
	margin-right: 2dp;
	text-align: center;
	background: #e6e9e9;
	color: #aeb7b8;
	border: 1dp #b5c1c2;
}

.cg-box.nonempty {
	background: #2e8b57;
	color: #000000;
}

.cg-box.allselected {
	background: #87ceeb;
	color: #000000;
}

.cg-box.autogold {
	border: 2dp #ffcb00;
}

/* Abilities panel: bottom-left, beside the selection readout. Small
   buttons fit all nine abilities in a 3x3 grid. */
#hud-abilities {
	left: 28%;
	bottom: 2%;
	width: 24%;
}

#abilities-grid {
	margin-left: 4dp;
	margin-top: 4dp;
	margin-bottom: 4dp;
}

.ab-btn {
	display: inline-block;
	width: 31%;
	height: 24dp;
	margin-right: 2dp;
	margin-top: 2dp;
	padding: 0;
}

.ab-btn.active {
	border: 2dp #2e8b57;
}

/* Factory panel: bottom-right quarter, tab-filtered rows (max 4). */
#hud-factory {
	right: 1%;
	bottom: 2%;
	width: 25%;
}

#factory-tabs {
	margin-left: 8dp;
	margin-top: 4dp;
}

.tab-btn {
	display: inline-block;
	width: 30%;
	height: 22dp;
	margin-right: 4dp;
	padding: 0;
}

.tab-btn.selected {
	border: 2dp #ffcb00;
}

.fac-row {
	height: 26dp;
	margin-left: 8dp;
	margin-top: 2dp;
}

.fac-btn {
	display: inline-block;
	width: 68%;
	height: 22dp;
	padding: 0;
}

.fac-rep {
	display: inline-block;
	width: 20%;
	height: 22dp;
	margin-left: 6dp;
	padding: 0;
}

#need-factory {
	margin-left: 12dp;
	margin-top: 6dp;
	color: #686868;
}

#fac-queue-row {
	margin-left: 8dp;
	margin-top: 4dp;
	color: #686868;
}

#queue-line {
	display: inline-block;
	width: 120dp;
}

#btn-cancel {
	display: inline-block;
	width: 90dp;
	height: 22dp;
	padding: 0;
}

/* "Producing..." bar floats above the factory panel. */
#hud-producing {
	position: absolute;
	right: 2%;
	bottom: 46%;
}

#producing-label {
	color: #828282;
}

#producing-bar {
	width: 150dp;
	height: 12dp;
	background: #d3d3d3;
	border: 1dp #838383;
	margin-top: 4dp;
}

#producing-fill {
	height: 100%;
	background: #2e8b57;
}

/* FPS readout under the stockpile panel. */
.hud-readout {
	position: absolute;
	right: 10dp;
	color: #828282;
}

#fps-line {
	top: 44%;
}

/* ShortcutHintLines from (8,250), muted. */
#hud-hints {
	position: absolute;
	left: 8dp;
	top: 250dp;
}

.hint-line {
	color: #505050;
	opacity: 0.8;
	height: 22dp;
	margin: 0;
}

/* Dim veil shared by the pause/outcome overlays (cf. #dim in theme). */
.hud-dim {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background: #000000;
	opacity: 0.5;
}

#pause-box {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 300dp;
	height: 580dp;
	margin-left: -150dp;
	margin-top: -290dp;
	background: #f5f5f5;
	border: 1dp #838383;
}

#pause-titlebar {
	width: 100%;
	height: 24dp;
	background: #c9c9c9;
	color: #505050;
	font-weight: bold;
	text-align: center;
}

.pause-btn {
	display: block;
	width: 264dp;
	height: 26dp;
	margin-left: 18dp;
	margin-top: 4dp;
}

.pause-label {
	margin-left: 18dp;
	margin-top: 2dp;
	color: #686868;
}

.pause-check {
	margin-left: 18dp;
	margin-top: 2dp;
	height: 24dp;
	color: #686868;
}

input.pause-range {
	display: block;
	width: 264dp;
	height: 20dp;
	margin-left: 18dp;
}

input.pause-range slidertrack {
	background: #e6e9e9;
	border: 1dp #838383;
	height: 10dp;
}

input.pause-range sliderbar {
	background: #c9c9c9;
	border: 1dp #838383;
	width: 14dp;
	height: 20dp;
}

input.pause-range sliderprogress {
	background: #97e8ff;
}

#outcome-box {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 300dp;
	height: 190dp;
	margin-left: -150dp;
	margin-top: -95dp;
	background: #f5f5f5;
	border: 1dp #838383;
}

#outcome-titlebar {
	width: 100%;
	height: 24dp;
	background: #c9c9c9;
	color: #505050;
	font-weight: bold;
	text-align: center;
}

#outcome-body {
	text-align: center;
	color: #686868;
	margin-top: 24dp;
}

/* Color-blind checkbox is visual-only in the probe. */
body.colorblind #hud-body-art {
	background: #e8e8e8;
}

/* Responsive: the % bottom row (selection + 24% abilities + 25% factory)
   collides on narrow windows, so shrink the fixed selection panel and let
   the % panels take relatively more room. */
@media (max-width: 777dp)
{
	#hud-selection {
		width: 220dp;
	}
	#hud-abilities {
		left: 238dp;
		width: 30%;
	}
	#hud-factory {
		width: 30%;
	}
	/* Narrow panels cannot fit the nowrap summary lines: clip instead of
	   overpainting the neighbour panel. */
	.hud-line {
		overflow: hidden;
	}
}
